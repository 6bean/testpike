# Fleet installer keys - configuration surface of the deploy/fleet scripts.
#
# The Kubernetes pool scripts (deploy/fleet/k8s) and the bare-metal node scripts
# (deploy/fleet/bare) read every value below as an environment override. Export the
# ones you need before running a script, or pass them inline:
#
#   EXECUTOR_POOL_CAPACITY=4 ./deploy/fleet/k8s/install-executor-pool.sh
#   EXECUTOR_NODE_ENROLL_TOKEN=... EXECUTOR_NODE_BASE_URL=https://... \
#       ./deploy/fleet/bare/install-executor-node.sh
#
# Each assignment shows the shipped default the script falls back to when the key is
# unset, so this file doubles as the reference for "what happens if I set nothing".
# tools/install_config_gate.py (rule fleet-keys-exposed) keeps this file and the
# scripts in parity: a key consumed by a script and missing here - or documented here
# and no longer consumed - turns the gate red.
#
# ---- Kubernetes executor pools (deploy/fleet/k8s/*.sh) ----
# Helm coordinates of the pool release. Change only when one cluster hosts several
# testPike installations that must not share a namespace or release name.
EXECUTOR_POOL_NAMESPACE=tp-fleet
EXECUTOR_POOL_RELEASE=tp-executor
# Chart directory used by install/upgrade, as a path inside this repository.
FLEET_CHART_DIR=deploy/fleet/charts/tp-executor
# Image pin. Set repository + tag, or repository + digest (sha256) for a verifiable
# production image; leave all three empty to use the image the chart itself ships.
EXECUTOR_POOL_IMAGE_REPOSITORY=
EXECUTOR_POOL_IMAGE_TAG=
EXECUTOR_POOL_IMAGE_SHA256=
# 0 (default) refuses to roll out without a pinned tag or digest; 1 allows a floating
# image. Keep 0 outside throwaway clusters - a floating tag cannot be audited later.
EXECUTOR_POOL_ALLOW_FLOATING_IMAGE=0
# Address the pooled executors call back to. IN_CLUSTER_API_URL wins when set (pods
# talk to the api service inside the cluster); otherwise API_URL (host-visible) is used.
# The install script refuses when neither is set, because executors could not report.
EXECUTOR_POOL_API_URL=
EXECUTOR_POOL_IN_CLUSTER_API_URL=
# What the pool registers as able to run (pool facts on the platform side).
EXECUTOR_POOL_CAPACITY=2
EXECUTOR_POOL_BROWSERS=chromium
EXECUTOR_POOL_END_TYPES=web
EXECUTOR_POOL_ENV_IDS=
EXECUTOR_POOL_GROUP_IDS=
EXECUTOR_POOL_VERSION=1.0.0
# Time budgets, Helm-style suffixes (300s) and plain seconds for drains.
# ROLLOUT_TIMEOUT: install falls back to 300s, the upgrade script falls back to 900s
# because rollouts there may wait on drains; set one value to override both paths.
EXECUTOR_POOL_ROLLOUT_TIMEOUT=300s
EXECUTOR_POOL_UNINSTALL_TIMEOUT=300s
EXECUTOR_POOL_DRAIN_WAIT_SECONDS=120
# ---- Bare-metal executor nodes (deploy/fleet/bare/*.sh) ----
# Enrollment credentials for the node agent. Both are required by
# install-executor-node.sh: ENROLL_TOKEN is issued by the platform's fleet enrollment
# wizard (single use), BASE_URL is where the agent reports back to.
EXECUTOR_NODE_ENROLL_TOKEN=
EXECUTOR_NODE_BASE_URL=
# Where the node package comes from and how it is verified. PACKAGE_URL accepts a local
# path or an http(s) URL; PACKAGE_SHA256 pins the checksum the fetched payload must
# match - leave it empty only for local development installs.
EXECUTOR_NODE_PACKAGE_URL=
EXECUTOR_NODE_PACKAGE_SHA256=
# Identity the agent registers under, plus optional extra facts handed to enrollment.
EXECUTOR_NODE_NAME=$(hostname)
EXECUTOR_NODE_FACTS_JSON=
# systemd layout. UNIT_DOMAIN=system installs machine-wide units (needs root); use
# user for rootless hosts. AGENT_UNIT names the agent service; RUNNER_UNIT optionally
# names a separate runner unit that gets a graceful stop before drain - empty means no
# extra unit is managed.
EXECUTOR_NODE_UNIT_DOMAIN=system
EXECUTOR_NODE_AGENT_UNIT=tp-service-agent
EXECUTOR_NODE_RUNNER_UNIT=
# Install targets on the host. Change when /opt or /var/lib layouts differ or the
# installing user cannot write these prefixes.
EXECUTOR_NODE_INSTALL_ROOT=/opt/testpike
EXECUTOR_NODE_STATE_DIR=/var/lib/testpike/service-agent
EXECUTOR_NODE_ENV_FILE=/etc/testpike/service-agent.env
EXECUTOR_NODE_UNIT_DIR=/etc/systemd/system
EXECUTOR_NODE_PYTHON=python3
# Grace period for in-flight tasks before the agent is drained.
EXECUTOR_NODE_DRAIN_WAIT_SECONDS=120
# 1 makes uninstall also remove the state directory; 0 keeps it for a reinstall.
EXECUTOR_NODE_PURGE_STATE=0
