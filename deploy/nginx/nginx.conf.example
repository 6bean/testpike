
server {
    listen 80;
    server_name testpike.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name testpike.example.com;

    ssl_certificate     /etc/nginx/certs/testpike.crt;
    ssl_certificate_key /etc/nginx/certs/testpike.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Upload door body cap: nginx's shipped default is 1m, which silently
    # rejects every document upload above 1MB with a raw 413 before the
    # request reaches admin. Keep this above the backend multipart ceiling
    # (admin spring max-request-size 101MB) so oversize uploads are refused
    # by the backend with a readable business message instead.
    client_max_body_size 110M;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://admin:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /open/ {
        proxy_pass http://api:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
