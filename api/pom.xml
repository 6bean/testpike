<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sixbean.testpike</groupId>
        <artifactId>testpike-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>testpike-api</artifactId>
    <name>testPike api</name>
    <description>面向接口对接（外部集成 /open/** + 执行器协议 /internal/executor/**）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- testPike common（统一响应/异常/RestClientInvoker，T04C 执行器协议入口复用） -->
        <dependency>
            <groupId>com.sixbean.testpike</groupId>
            <artifactId>testpike-common</artifactId>
            <version>${project.version}</version>
        </dependency>
 <!-- G6 /mcp：MCP Java SDK（spring-ai 1.1.8 内核同源版本， 实核：
             WebMvcStatelessServerTransport 在 mcp-spring-webmvc 0.18.3，逐请求
             McpTransportContext=scope/readonly 动态 tools/list 的装配基座；显式钉版本，
 spring-ai BOM 未进父 pom（api 仅用 SDK 不用 starter 自动装配， 路线 B） -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>0.18.3</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-spring-webmvc</artifactId>
            <version>0.18.5</version>
        </dependency>
        <!-- Redis：mcp.rate-limit/min 窗口计数 + 写工具 Idempotency-Key 幂等
             （IdempotentGuard 装配自 common，宿主须供 StringRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- java -jar hosting requires the executable fat jar:
                             repackage binds to the default package lifecycle. -->
                        <id>repackage-fat-jar</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
