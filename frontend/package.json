{
  "name": "testpike-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AI 自主测试用例生成与评审系统 - 前端（M1）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts --fix",
    "test:unit": "vitest run",
    "test:comp": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.1",
    "mermaid": "^11.17.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser-playwright": "5.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "playwright": "^1.65.1",
    "sass": "^1.83.0",
    "typescript": "^5.6.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "^2.1.10"
  }
}
