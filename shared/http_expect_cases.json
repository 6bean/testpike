{
  "note": "Two-source fixture for the 04 contract 2.1.2 http.request / net.assert expect object (status / body / durationMs / headers). Java side NonUiActionContractTest consumes positives/negatives as the save-gate authority (positives = no violation, negatives = violation message contains every errorIncludes anchor); python side executor/tests/test_t368_expect_duration_headers.py consumes judge rows against driver _check_http_expect to pin execution-side parity. Field shape mirrors ApiAssertionFormContract WS2 form rows (type/op/expect) so the promotion mapper can translate form rows into expect keys without inventing a second domain.",
  "positives": [
    { "expect": { "status": 200 } },
    { "expect": { "durationMs": { "op": "range", "expect": [0, 3000] } } },
    { "expect": { "durationMs": { "op": "range", "expect": [0, 500], "bounds": "right-open" } } },
    { "expect": { "headers": [{ "name": "Content-Type", "op": "contains", "expect": "json" }] } },
    { "expect": { "headers": [{ "name": "X-Trace-Id", "op": "regex", "expect": "^[0-9a-f]{8}$" }] } },
    { "expect": { "headers": [{ "name": "X-Retry", "op": "range", "expect": [1, 3] }] } },
    { "expect": { "status": 200, "body": [{ "path": "$.data.id", "matchType": "contains", "text": "42" }],
                  "durationMs": { "op": "range", "expect": [0, 1000] },
                  "headers": [{ "name": "Content-Type", "op": "contains", "expect": "json" }] } }
  ],
  "negatives": [
    { "expect": [200], "why": "expect must be an object", "errorIncludes": ["必须是对象"] },
    { "expect": { "durationms": { "op": "range", "expect": [0, 1] } },
      "why": "unknown key rejected (a mistyped assertion key must not silently no-op)",
      "errorIncludes": ["未声明键", "durationms"] },
    { "expect": { "durationMs": 3000 }, "why": "durationMs must be an object",
      "errorIncludes": ["durationMs 必须是对象"] },
    { "expect": { "durationMs": { "op": "between", "expect": [0, 1] } },
      "why": "duration op outside matcher family", "errorIncludes": ["matchType 仅支持"] },
    { "expect": { "durationMs": { "op": "contains", "expect": 5 } },
      "why": "duration expect must be a [min,max] numeric pair", "errorIncludes": ["[min,max]"] },
    { "expect": { "durationMs": { "op": "range", "expect": "5" } }, "why": "range needs a [min,max] pair",
      "errorIncludes": ["[min,max]"] },
    { "expect": { "durationMs": { "op": "range", "expect": [0, 1, 2] } }, "why": "pair length over 2",
      "errorIncludes": ["[min,max]"] },
    { "expect": { "durationMs": { "op": "range", "expect": [0, 100], "bounds": "half" } },
      "why": "bounds outside enum", "errorIncludes": ["bounds 仅支持"] },
    { "expect": { "headers": { "name": "X", "op": "contains", "expect": "y" } },
      "why": "headers must be an array", "errorIncludes": ["headers 必须是非空数组"] },
    { "expect": { "headers": [{ "op": "contains", "expect": "y" }] }, "why": "header row needs a name",
      "errorIncludes": ["头名"] },
    { "expect": { "headers": [{ "name": "X", "op": "equals", "expect": "y" }] },
      "why": "header op outside matcher family", "errorIncludes": ["matchType 仅支持"] },
    { "expect": { "headers": [{ "name": "X", "op": "regex", "expect": "(a+)+" }] },
      "why": "catastrophic-backtracking regex rejected", "errorIncludes": ["嵌套量词"] },
    { "expect": { "headers": [{ "name": "X", "op": "contains" }] }, "why": "missing expect value",
      "errorIncludes": ["期望值"] }
  ],
  "judge": {
    "positives": [
      { "expect": { "durationMs": { "op": "range", "expect": [0, 3000] } },
        "runCtx": { "status": 200, "durationMs": 120, "headers": {}, "bodyText": "{}" } },
      { "expect": { "durationMs": { "op": "range", "expect": [0, 120], "bounds": "right-open" } },
        "runCtx": { "status": 200, "durationMs": 100, "headers": {}, "bodyText": "{}" } },
      { "expect": { "headers": [{ "name": "Content-Type", "op": "contains", "expect": "json" }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "content-type": "application/json" }, "bodyText": "{}" } },
      { "expect": { "headers": [{ "name": "X-Trace-Id", "op": "regex", "expect": "^[0-9a-f]{8}$" }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "x-trace-id": "deadbeef" }, "bodyText": "{}" } },
      { "expect": { "headers": [{ "name": "X-Kind", "op": "exact", "expect": "order" }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "x-kind": "order" }, "bodyText": "{}" } },
      { "expect": { "headers": [{ "name": "X-Retry", "op": "range", "expect": [1, 3] }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "x-retry": "2" }, "bodyText": "{}" } },
      { "expect": { "status": 200, "durationMs": { "op": "range", "expect": [0, 500] },
                    "headers": [{ "name": "Content-Type", "op": "contains", "expect": "json" }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "content-type": "application/json" }, "bodyText": "{}" } }
    ],
    "negatives": [
      { "expect": { "durationMs": { "op": "range", "expect": [0, 100] } },
        "runCtx": { "status": 200, "durationMs": 120, "headers": {}, "bodyText": "{}" },
        "messageIncludes": ["断言不满足", "120", "100"] },
      { "expect": { "durationMs": { "op": "range", "expect": [0, 120], "bounds": "right-open" } },
        "runCtx": { "status": 200, "durationMs": 120, "headers": {}, "bodyText": "{}" },
        "messageIncludes": ["断言不满足"] },
      { "expect": { "headers": [{ "name": "Content-Type", "op": "contains", "expect": "xml" }] },
        "runCtx": { "status": 200, "durationMs": 100,
                    "headers": { "content-type": "application/json" }, "bodyText": "{}" },
        "messageIncludes": ["断言不满足", "Content-Type"] },
      { "expect": { "headers": [{ "name": "X-Missing", "op": "contains", "expect": "y" }] },
        "runCtx": { "status": 200, "durationMs": 100, "headers": {}, "bodyText": "{}" },
        "messageIncludes": ["断言不满足", "X-Missing"] },
      { "expect": { "durationMs": { "op": "range", "expect": [0, 500] } },
        "runCtx": { "status": 200, "durationMs": null, "headers": {}, "bodyText": "{}" },
        "messageIncludes": ["无耗时数据"] },
      { "expect": { "durationms": { "op": "range", "expect": [0, 500] } },
        "runCtx": { "status": 200, "durationMs": 100, "headers": {}, "bodyText": "{}" },
        "messageIncludes": ["未声明键"] }
    ]
  }
}
