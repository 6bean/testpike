{
  "_comment": "if condition 受限文法两端同源夹具（B12 T198，评估稿 R3：Python 侧 executor/driver/condition_expr.py 为权威，前端 TS 预检件 utils/conditionPrecheck.ts 只做 UX 提示）。消费方=executor/tests/test_t198_condition_shared.py（pytest）+ frontend/tests/ui/conditionPrecheck.test.ts（vitest），两端必须读本文件，禁各持一份副本漂移。negatives=任何作用域下两端一律拒绝；positives=按 scope 求值必为真。",
  "negatives": [
    { "expr": "__import__('os').system('id')", "why": "dunder/代码注入" },
    { "expr": "eval('1+1')", "why": "函数调用形态" },
    { "expr": "open('/etc/passwd').read()", "why": "调用+属性链越界" },
    { "expr": "os.system('ls')", "why": "属性链+调用" },
    { "expr": "x = 1", "why": "赋值非比较" },
    { "expr": "item['sku'] == 'x'", "why": "下标访问文法外" },
    { "expr": "", "why": "空表达式" },
    { "expr": "   ", "why": "纯空白" },
    { "expr": "a =", "why": "残缺等号" },
    { "expr": "== 1", "why": "缺左操作数" },
    { "expr": "1 < < 2", "why": "运算符重复" },
    { "expr": "(1 == 1", "why": "括号未闭合" },
    { "expr": "item.price >", "why": "缺右操作数" },
    { "expr": "true false", "why": "多余内容" },
    { "expr": "a && b &&", "why": "悬挂连接词" }
  ],
  "positives": [
    { "expr": "'a' == 'a'", "scope": {} },
    { "expr": "true", "scope": {} },
    { "expr": "item.price > 100", "scope": { "item": { "price": 120 } } },
    { "expr": "not promo.stackable", "scope": { "promo": { "stackable": false } } },
    { "expr": "count >= 1 && (flag or status == 'ok')", "scope": { "count": 2, "flag": false, "status": "ok" } },
    { "expr": "index == 0", "scope": { "index": 0 } }
  ]
}
